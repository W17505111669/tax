    "verify:progress": "pnpm --filter @tax/api verify:progress",
    "verify:locate": "pnpm --filter @tax/api verify:locate",
    "verify:tlcalls": "pnpm --filter @tax/api verify:tlcalls",
    "verify:review": "pnpm --filter @tax/api verify:review",
    "verify:runart": "pnpm --filter @tax/api verify:runart",
