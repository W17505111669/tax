    "verify:toutcome": "pnpm --filter @tax/api verify:toutcome",
    "verify:mdtext": "pnpm --filter @tax/api verify:mdtext",
    "verify:mdrender": "pnpm --filter @tax/api verify:mdrender",
    "verify:jsxkeys": "pnpm --filter @tax/api verify:jsxkeys",
    "verify:tfails": "pnpm --filter @tax/api verify:tfails",
    "repair:toolcalls": "pnpm --filter @tax/api repair:toolcalls",
    "scan:uimd": "pnpm --filter @tax/api scan:uimd",
    "verify:fresh": "pnpm --filter @tax/api verify:fresh",
    "verify:manifest": "pnpm --filter @tax/api verify:manifest",
    "verify:amounts": "pnpm --filter @tax/api verify:amounts",
    "typecheck": "pnpm -r typecheck"
