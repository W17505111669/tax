{
  "name": "tax-agent-competition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "全国税务师行业 AI 赋能涉税专业服务技能竞赛 - 双智能体共享技术底座",
  "scripts": {
    "dev": "pnpm --parallel --filter @tax/api --filter @tax/web dev",
    "dev:api": "pnpm --filter @tax/api dev",
    "dev:web": "pnpm --filter @tax/web dev",
    "verify:pi": "pnpm --filter @tax/agent-core verify:pi",
    "verify:docs": "pnpm --filter @tax/document-tools verify:docs",
    "verify:template": "pnpm --filter @tax/document-tools verify:template",
    "verify:policy": "pnpm --filter @tax/agent-rd-audit verify:policy",
    "verify:compare": "pnpm --filter @tax/document-tools verify:compare",
    "verify:ocr": "pnpm --filter @tax/document-tools verify:ocr",
    "verify:extract": "pnpm --filter @tax/document-tools verify:extract",
    "verify:diagram": "pnpm --filter @tax/document-tools verify:diagram",
    "report:test": "pnpm --filter @tax/api exec tsx scripts/gen-test-report.ts",
    "gen:materials": "pnpm --filter @tax/api exec tsx scripts/gen-materials.ts",
    "case:run": "pnpm --filter @tax/api case:run",
    "demo:script": "pnpm --filter @tax/api exec tsx scripts/gen-demo-script.ts",
    "gen:ppt": "pnpm --filter @tax/api exec tsx scripts/gen-ppt-outline.ts",
    "pack:evidence": "pnpm --filter @tax/api exec tsx scripts/pack-evidence.ts",
    "qa:all": "pnpm verify:pi && pnpm verify:docs && pnpm verify:template && pnpm verify:policy && pnpm verify:compare && pnpm verify:ocr && pnpm verify:extract && pnpm verify:diagram && pnpm verify:agents && pnpm verify:progress && pnpm verify:locate && pnpm verify:review && pnpm verify:tlcalls && pnpm verify:runart && pnpm verify:artsrc && pnpm verify:rtools && pnpm verify:revexp && pnpm verify:dcheck && pnpm verify:amounts && pnpm verify:links && pnpm report:test && pnpm gen:materials && pnpm demo:script && pnpm gen:ppt && pnpm pack:evidence",
    "verify:agents": "pnpm --filter @tax/api verify:agents",
    "verify:progress": "pnpm --filter @tax/api verify:progress",
    "verify:locate": "pnpm --filter @tax/api verify:locate",
    "verify:tlcalls": "pnpm --filter @tax/api verify:tlcalls",
    "verify:review": "pnpm --filter @tax/api verify:review",
    "verify:runart": "pnpm --filter @tax/api verify:runart",
    "verify:artsrc": "pnpm --filter @tax/api verify:artsrc",
    "verify:rtools": "pnpm --filter @tax/api verify:rtools",
    "verify:revexp": "pnpm --filter @tax/api verify:revexp",
    "verify:dcheck": "pnpm --filter @tax/api verify:dcheck",
    "verify:links": "pnpm --filter @tax/api verify:links",
    "verify:amounts": "pnpm --filter @tax/api verify:amounts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13"
  }
}
