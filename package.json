    "verify:rtools": "pnpm --filter @tax/api verify:rtools",
    "verify:revexp": "pnpm --filter @tax/api verify:revexp",
    "verify:dcheck": "pnpm --filter @tax/api verify:dcheck",
    "verify:links": "pnpm --filter @tax/api verify:links",
    "verify:fileparse": "pnpm --filter @tax/api verify:fileparse",
    "verify:upload": "pnpm --filter @tax/api verify:upload",
    "verify:bundle": "pnpm --filter @tax/api verify:bundle",
    "verify:stats": "pnpm --filter @tax/api verify:stats",
    "verify:policytrace": "pnpm --filter @tax/api verify:policytrace",
    "verify:docrefmd": "pnpm --filter @tax/api verify:docrefmd",
    "verify:websearch": "pnpm --filter @tax/api verify:websearch",
    "verify:citegrade": "pnpm --filter @tax/api verify:citegrade",
    "verify:searchev": "pnpm --filter @tax/api verify:searchev",
    "verify:refcheck": "pnpm --filter @tax/api verify:refcheck",
    "verify:revimpact": "pnpm --filter @tax/api verify:revimpact",
    "verify:trend": "pnpm --filter @tax/api verify:trend",
    "verify:sheet": "pnpm --filter @tax/api verify:sheet",
    "verify:amtnote": "pnpm --filter @tax/api verify:amtnote",
    "verify:ledger": "pnpm --filter @tax/api verify:ledger",
    "verify:csv": "pnpm --filter @tax/api verify:csv",
    "verify:diaexport": "pnpm --filter @tax/api verify:diaexport",
    "verify:localstore": "pnpm --filter @tax/api verify:localstore",
    "verify:format": "pnpm --filter @tax/api verify:format",
    "verify:reltime": "pnpm --filter @tax/api verify:reltime",
