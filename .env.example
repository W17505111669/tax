# ===== 模型网关配置 =====
# Pi SDK 通过 OpenAI 兼容端点访问模型。默认使用本机 cc-switch 网关。
TAXAI_BASE_URL=http://127.0.0.1:15721/v1
TAXAI_API_KEY=PROXY_MANAGED
TAXAI_API=openai-responses
TAXAI_MODEL=qwen3.8-max
TAXAI_THINKING=low

# 如改用其它 OpenAI 兼容服务（例如阿里云百炼），示例：
# TAXAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TAXAI_API_KEY=sk-xxxxxxxx
# TAXAI_API=openai-completions
# TAXAI_MODEL=qwen-max

# ===== 服务端口 =====
API_PORT=8787
WEB_PORT=5173
